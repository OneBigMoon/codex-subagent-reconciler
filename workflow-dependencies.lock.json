      "public": false,
      "contains": ["private-local ownership receipt", "component-status", "managed-relative-paths", "hashes", "device/inode ownership guards", "rollback-state", "managed role-file and venv ownership only", "all Setup-added Plugins installed-but-unowned", "legacy owned_plugins ignored", "separate confirmed Codex Plugin removal"],
